#FROM ghcr.io/astral-sh/uv:0.11.6-python3.13-trixie@sha256:b3c543b6c4f23a5f2df22866bd7857e5d304b67a564f4feab6ac22044dde719b AS uv_source
FROM registry.cn-beijing.aliyuncs.com/zexi/uv:0.11.6-python3.13-trixie AS uv_source

# Runtime image — no build stage needed, hermes-agent is Python source
FROM registry.cn-beijing.aliyuncs.com/cloudpods/webtop:ubuntu-xfce

ENV NODE_ENV=production
ENV PYTHONUNBUFFERED=1
# Store Playwright browsers outside the volume mount so the build-time
# install survives the /config volume overlay at runtime.
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/hermes/.playwright

# System dependencies — nodejs/npm/python3/gcc/git/ca-certificates/curl/procps/file
# are already present in the webtop base image (nodesource Node 22 bundles npm)
RUN apt-get update \
  && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    build-essential \
    nodejs \
    python3-dev \
    ripgrep \
    ffmpeg \
    libffi-dev \
    vim \
    iputils-ping \
    tmux \
    rsync \
  && rm -rf /var/lib/apt/lists/*

# Install Go (used by many skills)
# RUN curl -fsSL https://go.dev/dl/go1.24.1.linux-$(dpkg --print-architecture).tar.gz \
#     | tar -C /usr/local -xz
# ENV PATH="/usr/local/go/bin:${PATH}"

# Install uv (fast Python package manager)
COPY --chmod=0755 --from=uv_source /usr/local/bin/uv /usr/local/bin/uvx /usr/local/bin/

# Ensure tool paths survive login-shell PATH reset (/etc/profile overwrites PATH)
RUN printf '%s\n' \
  'export PATH="/home/linuxbrew/.linuxbrew/bin:/home/linuxbrew/.linuxbrew/sbin:/usr/local/go/bin:/opt/hermes/.venv/bin:$PATH"' \
  '[ -f /opt/hermes/.venv/bin/activate ] && source /opt/hermes/.venv/bin/activate' \
  > /etc/profile.d/custom-tools.sh \
  && chmod +x /etc/profile.d/custom-tools.sh

# XFCE terminal opens non-login interactive bash shells (reads /etc/bash.bashrc,
# not /etc/profile), so auto-activate the venv there too.
RUN printf '%s\n' \
  '' \
  '# Auto-activate hermes-agent Python venv for interactive shells' \
  '[ -f /opt/hermes/.venv/bin/activate ] && source /opt/hermes/.venv/bin/activate' \
  >> /etc/bash.bashrc

# Install Linuxbrew (installer refuses to run as root, so use a temp user)
RUN useradd -m -s /bin/bash linuxbrew \
  && mkdir -p /home/linuxbrew/.linuxbrew \
  && chown -R linuxbrew:linuxbrew /home/linuxbrew
USER linuxbrew

RUN HOME=/home/linuxbrew NONINTERACTIVE=1 /bin/bash -c \
    "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
USER root
RUN chmod -R a+rx /home/linuxbrew/.linuxbrew \
  && chown -R 1000:1000 /home/linuxbrew \
  && ( getent passwd 1000 | cut -d: -f1 | xargs -r -I {} usermod -aG linuxbrew {} || true )
ENV HOMEBREW_PREFIX="/home/linuxbrew/.linuxbrew" \
    HOMEBREW_CELLAR="/home/linuxbrew/.linuxbrew/Cellar" \
    HOMEBREW_REPOSITORY="/home/linuxbrew/.linuxbrew/Homebrew" \
    PATH="/home/linuxbrew/.linuxbrew/bin:/home/linuxbrew/.linuxbrew/sbin:${PATH}"

# Copy hermes-agent source (build context is ../hermes-agent)
COPY . /opt/hermes
WORKDIR /opt/hermes

# Install Node dependencies and Playwright as root (--with-deps needs apt)
RUN npm config set registry http://mirrors.cloud.tencent.com/npm/ \
  && npm install --prefer-offline --no-audit \
  && npx playwright install --with-deps chromium --only-shell \
  && cd /opt/hermes/scripts/whatsapp-bridge \
  && npm install --prefer-offline --no-audit \
  && npm cache clean --force

# Hand ownership to webtop default user (UID 1000), then install Python deps
RUN chown -R 1000:1000 /opt/hermes
USER 1000

ENV UV_CACHE_DIR=/tmp/uv-cache
ENV UV_DEFAULT_INDEX=https://mirrors.tuna.tsinghua.edu.cn/pypi/web/simple
ENV VIRTUAL_ENV=/opt/hermes/.venv
RUN uv venv "$VIRTUAL_ENV" && \
    uv pip install --no-cache-dir --python "$VIRTUAL_ENV/bin/python" -e ".[all]" && \
    rm -rf /tmp/uv-cache

USER root

ENV HERMES_HOME=/config/.hermes
